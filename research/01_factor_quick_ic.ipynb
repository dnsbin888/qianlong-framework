   "source": [
    "top_factor = results[0][0] if results else 'defensive_v2'\\n",
    "fn = COMPUTE.get(top_factor.replace(' ','_')) or COMPUTE.get('defensive_v2')\\n",
    "print(f\\"行业IC: {top_factor}\\\")\\n",
    "# TODO: add industry mapping"
   ]
  }
