   "source": [
    "# 快速因子IC对比\\n",
    "计算所有active因子的5日IC并排名"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.stats import spearmanr\\n",
    "import random\\n",
    "\\n",
    "def calc_ic(factor_name, n=200):\\n",
    "    fn = COMPUTE.get(factor_name)\\n",
    "    if not fn: return None\\n",
    "    syms = random.sample(sorted(DATA.keys()), min(n, len(DATA)))\\n",
    "    vals = []\\n",
    "    for sym in syms:\\n",
    "        df = DATA.get(sym)\\n",
    "        if df is None or len(df) < 60: continue\\n",
    "        try:\\n",
    "            fv = fn(df)\\n",
    "            if fv is None: continue\\n",
    "            fwd = (df.iloc[-1]['close'] - df.iloc[-6]['close']) / max(df.iloc[-6]['close'], 0.01)\\n",
    "            vals.append((float(fv), float(fwd)))\\n",
    "        except: continue\\n",
    "    if len(vals) < 30: return None\\n",
    "    fv_arr = np.array([v[0] for v in vals])\\n",
    "    ret_arr = np.array([v[1] for v in vals])\\n",
    "    ic, _ = spearmanr(fv_arr, ret_arr)\\n",
    "    return round(float(ic), 4)\\n",
    "\\n",
    "active = [f for f in FACTORS if f.get('status')=='active']\\n",
    "results = []\\n",
    "for fac in active:\\n",
    "    name = fac['name']\\n",
    "    ic = calc_ic(name, 200)\\n",
    "    if ic is not None:\\n",
    "        results.append((fac['display'], ic, fac.get('direction','long')))\\n",
    "        print(f\\"  {fac['display']:30s} IC={ic:+.4f}\\\")\\n",
    "\\n",
    "results.sort(key=lambda x: -abs(x[1]))\\n",
    "print(f\\\"\\\\nTop3: {results[:3]}\\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 行业IC分析\\n",
    "选取top因子，看在不同行业的表现"
   ]
  },
  {
   "cell_type": "code",
